# Network
PORT=3000
HOST=0.0.0.0

# Optional media and cache locations
VIDEO_DIR=/absolute/path/to/videos
CACHE_DIR=/absolute/path/to/cache
MAX_CACHE_MB=500
MAX_BODY_MB=20

# Administration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_TTL_HOURS=24

# Optional metadata provider
OMDB_API_KEY=
TMDB_API_KEY=

# Reverse proxy and HTTPS
DOMAIN=localhost
